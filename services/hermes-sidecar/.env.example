# Hermes Mobile Sidecar — Safe Development Mode
# Copy this file to .env and adjust for your environment.
# Never commit the real .env file.

PORT=18790
HOST=127.0.0.1
LOG_LEVEL=info

HERMES_INTEGRATION_MODE=mock
MOBILE_WRITE_ACTIONS_ENABLED=false
PUSH_DELIVERY_ENABLED=false
DATABASE_MODE=test

# Mock API key for development — replace with real key in production
HERMES_API_KEY=change_me_in_production

# Mock server listens here (used in test mode)
MOCK_HERMES_PORT=18642
MOCK_HERMES_HOST=127.0.0.1

# Production settings (uncomment when deploying)
# HERMES_INTEGRATION_MODE=live
# HERMES_GATEWAY_URL=http://127.0.0.1:8642
# SIDECAR_BIND_ADDRESS=127.0.0.1:8790
